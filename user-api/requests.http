# USER API ================================================================

@host=localhost:8080
# AuthController
### Autenticar e receber um TOKEN
POST /api/auth/login HTTP/1.1
Host: localhost:8080
Content-Type: application/json

{
    "username": "teste",
    "password": "1234"
}

### Sair
POST /api/auth/logout HTTP/1.1
Host: localhost:8080

### TODOS OS USUÁRIOS
GET /api/v1/users HTTP/1.1
Host: localhost:8080
Accept: application/json

### Get all users --- AUTENTICADO
# @name= getAllUsers

GET /api/v1/users HTTP/1.1
Host: {{host}}
Accept: application/json
Authorization: Bearer nk-EhWH76pya6u7RsCqIbO9YAH52_SvSTHZTA67ChAc

### Create a new valid User
# @name = createNewUser

POST /api/v1/users HTTP/1.1
Host: {{host}}
Content-Type: application/json

{
    "email": "batata@potato.com",
    "password": "1234RT56",
    "handle": "papas",
    "name": "Kartofel",
    "roles": [
        "ROLE_USER"
    ],
    "company": "potato inc"
}


### Try and create an invalid User
# @name = tryCreateInvalidUser

POST /api/v1/users HTTP/1.1
Host: {{host}}
Content-Type: application/json

{
    "email": "batata@potato.com",
    "password": "1234",
    "handle": "papas",
    "name": "Kartofel",
    "roles": [
        "ROLE_USER"
    ],
    "company": "potato inc"
}

### GET FIRST 10 REPORTS
GET /api/v1/vulnerability-reports HTTP/1.1
Host: {{host}}
Accept: application/json

### GET THIRD PAGE
GET /api/v1/vulnerability-reports?page=3&size=10 HTTP/1.1
Host: {{host}}
Accept: application/json

### Get vulnerability reports (page 1, size 5)
# @name = getVulnerabilityReports
GET http://localhost:8080/api/v1/vulnerability-reports?page=1&size=5
Accept: application/json

### Invalid page (negative)
# @name = getVulnerabilityReportsInvalidPage
GET http://localhost:8080/api/v1/vulnerability-reports?page=-1&size=2
Accept: application/json

### Invalid size (negative)
# @name = getVulnerabilityReportsInvalidSize
GET http://localhost:8080/api/v1/vulnerability-reports?page=1&size=-5
Accept: application/json

### Size over limit
# @name = getVulnerabilityReportsSizeAboveLimit
GET http://localhost:8080/api/v1/vulnerability-reports?page=1&size=2000
Accept: application/json

### Last page
# @name = getVulnerabilityReportsLastPage
GET http://localhost:8080/api/v1/vulnerability-reports?page=4&size=5
Accept: application/json